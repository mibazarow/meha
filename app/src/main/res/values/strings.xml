    <!-- Incoming SMS -->
    <string name="settings_sms_title">Входящие SMS</string>
    <string name="settings_sms_label">Обрабатывать входящие SMS</string>
    <string name="settings_sms_hint">Приложение читает входящие SMS, чтобы реагировать на них: разбирает номер отправителя и создаёт чат для незнакомых номеров. Это общий переключатель перехвата событий (SMS и звонки). Нужно разрешение «SMS» на экране «Все разрешения».</string>

    <!-- Communications («Связи») -->
    <string name="settings_comm_title">Связи</string>
    <string name="settings_comm_mode_label">Обработка записей и расшифровка</string>
    <string name="settings_comm_mode_off">Выкл</string>
    <string name="settings_comm_mode_charging">На зарядке</string>
    <string name="settings_comm_mode_always">Всегда</string>
    <string name="settings_comm_mode_hint">Когда приложение может автоматически сканировать записи диктофона и аудиофайлы и расшифровывать их на устройстве. По умолчанию — только на зарядке: расшифровка на телефоне расходует батарею, поэтому в фоне без питания она не запускается. Записывать телефонные звонки Android не позволяет - этого нет.</string>
    <string name="settings_comm_cloud_label">Отправлять текст расшифровок в облако</string>
    <string name="settings_comm_cloud_hint">Аудио никогда не покидает устройство; в облако может уйти только текст. Выключите, если хотите полностью локальный режим: тогда сводки в облаке не строятся, а поиск по расшифровкам работает только на телефоне.</string>
    <string name="settings_comm_whisper_label">Модель распознавания речи</string>
    <string name="settings_whisper_base">Whisper base (многоязычная)</string>
    <string name="settings_whisper_small">Whisper small (многоязычная)</string>
    <string name="settings_comm_whisper_desc">%1$s, размер %2$s. Скачивается один раз, дальше работает офлайн.</string>
    <string name="settings_comm_downloaded">Модель загружена.</string>
    <string name="settings_comm_keep_audio_days">Хранить аудио, дней</string>
    <string name="settings_comm_cache_limit">Лимит аудиокеша, МБ</string>
    <string name="settings_comm_retention_hint">Аудио хранится ограниченное время и вытесняется по лимиту кеша; расшифровки (текст) остаются в локальной базе.</string>
    <string name="settings_comm_bg_minutes">Расшифровка в фоне, мин/день</string>
    <string name="settings_comm_bg_minutes_hint">Сколько минут в сутки фоновый проход может тратить на расшифровку записей диктофона и аудиофайлов. Когда лимит исчерпан, обработка останавливается до следующего дня.</string>
    <string name="settings_comm_privacy">Конфиденциальность и закон. Записывать телефонные звонки Android не позволяет - этого нет. Расшифровка аудио на устройстве: записи диктофона и аудиофайлы; голосовые сообщения мессенджеров (через захват звука с вашего подтверждения); диктовка в чате. Нужна скачанная модель распознавания. Постоянного прослушивания (ambient) нет. Запись разговоров регулируется законом: во многих странах и регионах записывать разговор можно только с согласия всех участников или уведомив их. Убедитесь, что не нарушаете местные правила.</string>

    <!-- Overlay assistant -->
    <string name="settings_overlay_title">Плавающий помощник</string>
    <string name="settings_overlay_label">Пузырёк поверх других приложений</string>
    <string name="settings_overlay_hint">Показывает небольшой перетаскиваемый пузырёк поверх других приложений: нажмите на него, чтобы спросить Меха, не выходя из текущего экрана. Долгое нажатие убирает пузырёк. Для этого нужно разрешение «Поверх других приложений» (SYSTEM_ALERT_WINDOW) — приложение показывает окно только после того, как вы выдадите его в системных настройках.</string>
