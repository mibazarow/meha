    <!-- ============================ Agent activity screen (unified style) ============================ -->
    <string name="activity_section_about_title">How it works</string>
    <string name="activity_intro">This collects what the agent did on the phone: tool, time and result. Only actions with a reverse operation can be undone — for example creating a note, task or memory entry; the rest stay in history and cannot be undone.</string>
