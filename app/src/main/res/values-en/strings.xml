    <!-- Communications -->
    <string name="settings_comm_title">Communications</string>
    <string name="settings_comm_mode_label">Recording processing and transcription</string>
    <string name="settings_comm_mode_off">Off</string>
    <string name="settings_comm_mode_charging">While charging</string>
    <string name="settings_comm_mode_always">Always</string>
    <string name="settings_comm_mode_hint">When the app may automatically scan dictaphone recordings and audio files and transcribe them on the device. Default: only while charging — on-device transcription uses the battery, so it does not run in the background without power. Android does not allow recording phone calls — that is not available.</string>
    <string name="settings_comm_cloud_label">Send transcript text to the cloud</string>
    <string name="settings_comm_cloud_hint">Audio never leaves the device; only text may go to the cloud. Turn this off for a fully local mode: then no cloud summaries are built and transcript search runs only on the phone.</string>
    <string name="settings_comm_whisper_label">Speech recognition model</string>
    <string name="settings_whisper_base">Whisper base (multilingual)</string>
    <string name="settings_whisper_small">Whisper small (multilingual)</string>
    <string name="settings_comm_whisper_desc">%1$s, size %2$s. Downloaded once, then works offline.</string>
    <string name="settings_comm_downloaded">Model downloaded.</string>
    <string name="settings_comm_keep_audio_days">Keep audio, days</string>
    <string name="settings_comm_cache_limit">Audio cache limit, MB</string>
    <string name="settings_comm_retention_hint">Audio is kept for a limited time and evicted by the cache limit; transcripts (text) stay in the local database.</string>
    <string name="settings_comm_bg_minutes">Background transcription, min/day</string>
    <string name="settings_comm_bg_minutes_hint">How many minutes per day the background pass may spend transcribing dictaphone recordings and audio files. Once the limit is used up, processing stops until the next day.</string>
    <string name="settings_comm_privacy">Privacy and law. Android does not allow recording phone calls — that is not available. On-device audio transcription: dictaphone recordings and audio files; messenger voice messages (by capturing sound with your confirmation); dictation in chat. Requires a downloaded recognition model. There is no always-on (ambient) listening. Recording conversations is regulated by law: in many countries and regions you may record a conversation only with the consent of all participants or after notifying them. Make sure you do not break local rules.</string>

